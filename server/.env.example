NODE_ENV=development
PORT=3100
PUBLIC_API_URL=http://localhost:3100
H5_ORIGIN=http://localhost:10086
DATABASE_URL=postgresql://biterstore:biterstore@localhost:5432/biterstore
REDIS_URL=redis://localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
# Trust only the direct reverse proxy by default in production. Set the exact
# hop count or explicit CIDRs for your own proxy/tunnel topology.
TRUST_PROXY_HOPS=1
TRUSTED_PROXY_CIDRS=
# Public catalog protection. Values are per client unless marked global.
PUBLIC_CATALOG_CACHE_ENABLED=true
PUBLIC_CATALOG_LIST_CACHE_SECONDS=20
PUBLIC_CATALOG_DETAIL_CACHE_SECONDS=30
PUBLIC_CATALOG_LIST_RATE_PER_MINUTE=60
PUBLIC_CATALOG_SEARCH_RATE_PER_MINUTE=30
PUBLIC_CATALOG_DETAIL_RATE_PER_MINUTE=120
PUBLIC_CATALOG_GLOBAL_RATE_PER_MINUTE=1200
PUBLIC_MEDIA_RATE_PER_MINUTE=180
PUBLIC_MEDIA_GLOBAL_RATE_PER_MINUTE=3600
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ADMIN_TOTP_ENCRYPTION_KEY=replace-with-another-long-random-secret
CAMPUS_IDENTITY_HASH_KEY=replace-with-a-third-independent-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=http://localhost:3100/api/v1/auth/wechat/web/callback
BIT_LOGIN_ISSUER=bit-login
BIT_LOGIN_AUDIENCE=biterstore
BIT_LOGIN_PUBLIC_KEY_PEM=
BIT_LOGIN_HEALTH_URL=http://localhost:16384/
READINESS_TIMEOUT_MS=5000
READINESS_CACHE_MS=10000
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=biterstore
# local（默认）直接写入本机目录；r2 使用上面的 R2 配置
UPLOAD_STORAGE=local
LOCAL_UPLOAD_DIR=uploads
UPLOAD_PENDING_TTL_SECONDS=86400
UPLOAD_UNBOUND_TTL_SECONDS=86400
UPLOAD_MAX_UNBOUND_FILES_PER_USER=30
UPLOAD_MAX_UNBOUND_BYTES_PER_USER=104857600
UPLOAD_PRESIGN_PER_MINUTE=30
UPLOAD_CONTENT_PER_MINUTE=60
UPLOAD_COMPLETE_PER_MINUTE=60
UPLOAD_IMAGE_VALIDATION_CONCURRENCY=2
UPLOAD_IMAGE_VALIDATION_TIMEOUT_MS=5000
BOOK_RECOGNITION_PER_MINUTE=10
BOOK_RECOGNITION_CONCURRENCY=2
BOOK_RECOGNITION_TIMEOUT_MS=8000
ACCOUNT_RECOVERY_DAYS=30
CHAT_SEND_PER_MINUTE=30
CHAT_CONVERSATION_SEND_PER_MINUTE=60
BOOK_METADATA_PROXY_URL=
BOOK_METADATA_PROXY_TOKEN=
BOOK_METADATA_USER_AGENT=BITerStore/1.0 (https://store.example.com)
ALLOW_DEV_AUTH=true
