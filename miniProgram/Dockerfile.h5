FROM node:22-alpine AS build
WORKDIR /workspace/miniProgram
COPY miniProgram/package*.json ./
RUN npm ci
RUN npm install --no-save @tarojs/binding-linux-x64-musl@4.2.1
COPY miniProgram/ ./
COPY web/ /workspace/web/
ENV NODE_ENV=production
ENV BITERSTORE_API_URL=/api/v1
RUN npm run build:h5
FROM nginx:1.27-alpine
COPY --from=build /workspace/miniProgram/dist /usr/share/nginx/html
RUN printf 'server { listen 80; root /usr/share/nginx/html; location / { try_files $uri $uri/ /index.html; add_header Cache-Control "no-cache"; } location ~* \\.(js|css)$ { expires 30d; add_header Cache-Control "public, max-age=2592000, immutable"; } location ~* \\.(png|jpg|jpeg|webp|svg|ico)$ { expires 7d; add_header Cache-Control "public, max-age=604800"; } }' > /etc/nginx/conf.d/default.conf
