FROM node:22-alpine AS build
WORKDIR /workspace/miniProgram
COPY miniProgram/package*.json ./
RUN npm ci --no-audit
RUN npm install --no-save --no-audit @tarojs/binding-linux-x64-musl@4.2.1
COPY miniProgram/ ./
COPY web/ /workspace/web/
RUN npm run audit:dependencies
ENV NODE_ENV=production
ARG BITERSTORE_API_URL=/api/v1
ARG BIT_LOGIN_URL=/bit-login
ENV BITERSTORE_API_URL=$BITERSTORE_API_URL
ENV BIT_LOGIN_URL=$BIT_LOGIN_URL
RUN npm run build:h5
FROM nginx:1.27-alpine
COPY --from=build /workspace/miniProgram/dist /usr/share/nginx/html
COPY miniProgram/nginx.h5.conf /etc/nginx/conf.d/default.conf
