{
  "compilerOptions": {
    "target": "ES2019", "module": "commonjs", "moduleResolution": "node",
    "strict": true, "skipLibCheck": true, "noUnusedLocals": false, "noUnusedParameters": false,
    "allowSyntheticDefaultImports": true, "esModuleInterop": true,
    "resolveJsonModule": true, "jsx": "react-jsx", "sourceMap": true,
    "baseUrl": ".", "paths": { "@/*": ["src/*"] },
    "types": ["@tarojs/taro", "node", "vitest/globals"]
  },
  "include": ["src", "types", "config", "test"], "compileOnSave": false
}
